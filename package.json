{
  "name": "kfc-cn-mcp",
  "version": "1.0.0",
  "description": "MCP server for ordering at KFC China (order.kfc.com.cn). Hermes-compatible, stdio transport.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "kfc-cn-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "hermes",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "watch": "tsc -p tsconfig.json --watch",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "mcp",
    "hermes",
    "kfc",
    "肯德基",
    "ordering"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  }
}
